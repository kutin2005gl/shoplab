# ============================================================
# .env.example — FILE MẪU, ĐƯỢC COMMIT LÊN GITHUB.
# TUYỆT ĐỐI KHÔNG điền giá trị thật (mật khẩu, key, secret) vào file này.
#
# Cách dùng:
#   1. Copy file này thành .env.secure (và .env.vuln khi tới Phase 10):
#        cp .env.example .env.secure
#   2. Đổi các giá trị mẫu trong bản copy. Các file .env.* đã nằm trong .gitignore.
#
# Mỗi PR chỉ thêm đúng biến nó cần, với giá trị mẫu rõ ràng là giả.
# ============================================================

# --- Database (PR-003) — các tên biến này do image postgres quy định ---
POSTGRES_DB=shoplab_secure
POSTGRES_USER=shoplab
# Giá trị giả. Đổi thành chuỗi ngẫu nhiên dài trong .env.secure của bạn.
POSTGRES_PASSWORD=doi-thanh-mat-khau-ngau-nhien
